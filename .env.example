# Offline by default. Benchmark and tests always force offline mode.
LLM_MODE=offline
LLM_PROVIDER=openai
LLM_MODEL=stub
LLM_TEMPERATURE=0
JUDGE_MODE=offline
JUDGE_PROVIDER=openai
JUDGE_MODEL=stub
COMPACT_THRESHOLD_TOKENS=1200
COMPACT_KEEP_MESSAGES=4
MEMORY_CONFIDENCE_THRESHOLD=0.8
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_HALF_LIFE_TURNS=100
MEMORY_DECAY_MIN_PRIORITY=0.2

# For live mode: LLM_MODE=live and LLM_MODEL=<your available model>.
# Never put real keys in this example file.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# GROQ_API_KEY=gsk_xxxxxxxxx
